PORT=5001

# PostgreSQL (production / hosted)
DATABASE_URL=your_postgresql_connection_string

# Set to "disable" for local Docker/plain connections
PGSSLMODE=

# PostgreSQL (local fallback — used when DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=payflow

# JWT secrets
JWT_SECRET=your_jwt_secret
REFRESH_SECRET=your_refresh_secret

# CORS origin for the dashboard client
CLIENT_URL=http://localhost:3000